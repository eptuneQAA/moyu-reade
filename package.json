{
  "name": "moyu-reader",
  "version": "0.2.0",
  "description": "A local novel reader for TXT, EPUB, PDF and Markdown",
  "type": "module",
  "license": "MIT",
  "author": "moyu-reader contributors",
  "keywords": [
    "novel",
    "reader",
    "tui",
    "terminal",
    "epub",
    "pdf",
    "markdown",
    "ink"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "moyu": "bin/moyu"
  },
  "scripts": {
    "build": "esbuild src/cli.js --bundle --platform=node --format=esm --packages=external --jsx=automatic --outfile=dist/cli.js --sourcemap",
    "build:bundle": "node scripts/build-bundle.mjs",
    "build:web": "vite build --config web/vite.config.ts",
    "build:all": "npm run build && npm run build:bundle && npm run build:web",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:api": "node scripts/dev-server.mjs",
    "deb": "scripts/build-deb.sh",
    "prepare": "npm run build",
    "start": "node dist/cli.js",
    "dev": "npm run build && node dist/cli.js",
    "test": "node --test"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "dompurify": "^3.4.17",
    "iconv-lite": "^0.7.3",
    "ink": "^8.0.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "string-width": "^8.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
